<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!-- M3 Expressive Dark Tone-Based Surface & Color Roles -->
        <Color x:Key="M3SurfaceColor">#121318</Color>
        <Color x:Key="M3SurfaceContainerColor">#1E2028</Color>
        <Color x:Key="M3SurfaceContainerHighColor">#282A34</Color>
        <Color x:Key="M3SurfaceContainerHighestColor">#333541</Color>
        <Color x:Key="M3OnSurfaceColor">#E3E2E9</Color>
        <Color x:Key="M3OnSurfaceVariantColor">#C4C6D0</Color>

        <Color x:Key="M3PrimaryColor">#A8C7FA</Color>
        <Color x:Key="M3OnPrimaryColor">#062E6F</Color>
        <Color x:Key="M3PrimaryContainerColor">#0842A0</Color>
        <Color x:Key="M3OnPrimaryContainerColor">#D3E3FD</Color>

        <Color x:Key="M3SecondaryContainerColor">#3B4858</Color>
        <Color x:Key="M3OnSecondaryContainerColor">#D7E3F7</Color>

        <Color x:Key="M3TertiaryContainerColor">#14534B</Color>
        <Color x:Key="M3OnTertiaryContainerColor">#9EF2E4</Color>

        <Color x:Key="M3OutlineColor">#8E9099</Color>
        <Color x:Key="M3OutlineVariantColor">#44474E</Color>

        <SolidColorBrush x:Key="M3SurfaceBrush" Color="{StaticResource M3SurfaceColor}" />
        <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="{StaticResource M3SurfaceContainerColor}" />
        <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="{StaticResource M3SurfaceContainerHighColor}" />
        <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="{StaticResource M3SurfaceContainerHighestColor}" />
        <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="{StaticResource M3OnSurfaceColor}" />
        <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="{StaticResource M3OnSurfaceVariantColor}" />

        <SolidColorBrush x:Key="M3PrimaryBrush" Color="{StaticResource M3PrimaryColor}" />
        <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="{StaticResource M3OnPrimaryColor}" />
        <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="{StaticResource M3PrimaryContainerColor}" />
        <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="{StaticResource M3OnPrimaryContainerColor}" />

        <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="{StaticResource M3SecondaryContainerColor}" />
        <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="{StaticResource M3OnSecondaryContainerColor}" />

        <SolidColorBrush x:Key="M3TertiaryContainerBrush" Color="{StaticResource M3TertiaryContainerColor}" />
        <SolidColorBrush x:Key="M3OnTertiaryContainerBrush" Color="{StaticResource M3OnTertiaryContainerColor}" />

        <SolidColorBrush x:Key="M3OutlineBrush" Color="{StaticResource M3OutlineColor}" />
        <SolidColorBrush x:Key="M3OutlineVariantBrush" Color="{StaticResource M3OutlineVariantColor}" />

        <!-- Material Symbols / M3 Icon Geometries (24x24) -->
        <StreamGeometry x:Key="IconUndo">M12.5,8 C9.85,8 7.45,8.99 5.6,10.6 L2,7 L2,16 L11,16 L7.38,12.38 C8.77,11.22 10.54,10.5 12.5,10.5 C16.04,10.5 19.05,12.81 20.1,16 L22.47,15.22 C21.08,11.03 17.15,8 12.5,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRedo">M18.4,10.6 C16.55,8.99 14.15,8 11.5,8 C6.85,8 2.92,11.03 1.54,15.22 L3.9,16 C4.95,12.81 7.95,10.5 11.5,10.5 C13.45,10.5 15.23,11.22 16.62,12.38 L13,16 L22,16 L22,7 L18.4,10.6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClear">M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z M8,9 L16,9 L16,19 L8,19 L8,9 Z M15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 L15.5,4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconOpen">M20,6 L12,6 L10,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 Z M20,18 L4,18 L4,8 L20,8 L20,18 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSave">M17,3 L5,3 C3.89,3 3,3.9 3,5 L3,19 C3,20.1 3.89,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,7 L17,3 Z M19,19 L5,19 L5,5 L16.17,5 L19,7.83 L19,19 Z M12,12 C10.34,12 9,13.34 9,15 C9,16.66 10.34,18 12,18 C13.66,18 15,16.66 15,15 C15,13.34 13.66,12 12,12 Z M6,6 L15,6 L15,10 L6,10 L6,6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconImage">M21,19 L21,5 C21,3.9 20.1,3 19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 Z M8.5,13.5 L11,16.51 L14.5,12 L19,18 L5,18 L8.5,13.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconResolveFrame">M3,5 C3,3.9 3.9,3 5,3 L9,3 L9,5 L5,5 L5,9 L3,9 L3,5 Z M15,3 L19,3 C20.1,3 21,3.9 21,5 L21,9 L19,9 L19,5 L15,5 L15,3 Z M5,15 L5,19 L9,19 L9,21 L5,21 C3.9,21 3,20.1 3,19 L3,15 L5,15 Z M19,15 L21,15 L21,19 C21,20.1 20.1,21 19,21 L15,21 L15,19 L19,19 L19,15 Z M12,8 C9.79,8 8,9.79 8,12 C8,14.21 9.79,16 12,16 C14.21,16 16,14.21 16,12 C16,9.79 14.21,8 12,8 Z M12,14 C10.9,14 10,13.1 10,12 C10,10.9 10.9,10 12,10 C13.1,10 14,10.9 14,12 C14,13.1 13.1,14 12,14 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPen">M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z</StreamGeometry>
        <StreamGeometry x:Key="IconEraser">M16.24,3.56 L21.19,8.5 C21.97,9.29 21.97,10.55 21.19,11.34 L12,20.53 C11.22,21.31 9.95,21.31 9.17,20.53 L2.81,14.17 C2.03,13.39 2.03,12.12 2.81,11.34 L13.41,3.56 C14.19,2.78 15.46,2.78 16.24,3.56 Z M10.59,19.12 L14.83,14.88 L9.17,9.22 L4.22,12.76 L10.59,19.12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStylus">M18.62,3.15 L20.85,5.38 C21.58,6.11 21.58,7.3 20.85,8.03 L9.96,18.92 L5.08,14.04 L15.97,3.15 C16.7,2.42 17.89,2.42 18.62,3.15 Z M4.24,15.61 L8.39,19.76 L3,21 L4.24,15.61 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlay">M8,5.14 L8,19.14 L19,12.14 L8,5.14 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M6,19 L10,19 L10,5 L6,5 L6,19 Z M14,5 L14,19 L18,19 L18,5 L14,5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStop">M6,6 L18,6 L18,18 L6,18 L6,6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMovie">M18,4 L20,8 L17,8 L15,4 L13,4 L15,8 L12,8 L10,4 L8,4 L10,8 L7,8 L5,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,4 L18,4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSendToResolve">M19,3 L5,3 C3.89,3 3,3.9 3,5 L3,9 L5,9 L5,5 L19,5 L19,19 L5,19 L5,15 L3,15 L3,19 C3,20.1 3.89,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M10.09,15.59 L11.5,17 L16.5,12 L11.5,7 L10.09,8.41 L12.67,11 L3,11 L3,13 L12.67,13 L10.09,15.59 Z</StreamGeometry>
    </Styles.Resources>

    <!-- Floating Toolbar Container (64dp default height, CornerFull pill) -->
    <Style Selector="Border.m3FloatingToolbar">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
    </Style>

    <!-- Compact Floating Pill (top utility bar / status badge) -->
    <Style Selector="Border.m3FloatingPill">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #4D000000" />
    </Style>

    <!-- Standard Round Toolbar Button (48dp accessible hit height) -->
    <Style Selector="Button.m3ToolbarBtn">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.22" Easing="BackEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3ToolbarBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="Button.m3ToolbarBtn:pressed">
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- M3 Expressive Small Icon Button (40x40dp round, morphs to 12dp on press) -->
    <Style Selector="Button.m3IconBtn">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.22" Easing="BackEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3IconBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="Button.m3IconBtn:pressed">
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Icon Sizing Helpers -->
    <Style Selector="PathIcon.m3ActionIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="PathIcon.m3BtnIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="PathIcon.m3FabIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <!-- Connected Button Group (Pen | Eraser) -->
    <Style Selector="Button.m3ConnectedLeft">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20,8,8,20" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.24" Easing="BackEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3ConnectedRight">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8,20,20,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.24" Easing="BackEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3ConnectedLeft.active, Button.m3ConnectedRight.active">
        <Setter Property="Background" Value="{StaticResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnSecondaryContainerBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Palm Rejection Toggle Pill -->
    <Style Selector="ToggleButton.m3PalmToggle">
        <Setter Property="Background" Value="{StaticResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnSurfaceVariantBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.m3PalmToggle:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource M3TertiaryContainerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnTertiaryContainerBrush}" />
    </Style>
    <Style Selector="ToggleButton.m3PalmToggle:checked">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Extended FAB (Primary High-Emphasis Action: Export Resolve) -->
    <Style Selector="Button.m3ExtendedFab">
        <Setter Property="Background" Value="{StaticResource M3PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.22" Easing="BackEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3ExtendedFab:pressed">
        <Setter Property="CornerRadius" Value="28" />
    </Style>

    <!-- Secondary FAB (Export .setting file alongside Inject Resolve) -->
    <Style Selector="Button.m3SecondaryFab">
        <Setter Property="Background" Value="{StaticResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnSecondaryContainerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.22" Easing="BackEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.m3SecondaryFab:pressed">
        <Setter Property="CornerRadius" Value="28" />
    </Style>

    <!-- Dialog Buttons (Text low-emphasis + Filled high-emphasis) -->
    <Style Selector="Button.m3TextBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource M3PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.m3FilledBtn">
        <Setter Property="Background" Value="{StaticResource M3PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource M3OnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Color Swatch Ring (48x48dp accessible target, optical nested circle) -->
    <Style Selector="Border.m3SwatchTarget">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.m3SwatchRing">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderBrush" Value="{StaticResource M3OutlineVariantBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.m3SwatchRing.selected">
        <Setter Property="BorderBrush" Value="{StaticResource M3PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
</Styles>
